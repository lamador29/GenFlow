# Config
config = globals().get("config", {})
config_defaults = {
    "mode": "bacteria",            # "bacteria" or "fungi"
    "outdir": "results",
    "threads": 8,
    "G": 0.8,
    "F": 0.8,
    "mcl_inflation": 10,           # MCL inflation (pangenome clustering)
    "genomes": "Data/genomes.txt", # list of NCBI accessions (if NCBI download is enabled)
    "fasta": None,                 # CSV of input FASTA paths; if None, auto-detects in ./data and ./ (cwd)
    "DNA_mode": False,             # True = DNA tree (FastTree -nt); False = protein
    "use_ncbi_download": False,    # enable NCBI datasets+EDirect download block
    "run_ani": False,              # enable pyANI block (ANI matrix + heatmap assets)
}
for key, value in config_defaults.items():
    if key not in config:
        config[key] = value
cfg = config

import os, glob, shutil, pathlib, subprocess

# Dynamically detect samples right before annotation
def detect_samples():
    import glob, pathlib
    samples = [pathlib.Path(f).stem for f in glob.glob("Intermediate/*.fasta")]
    if not samples:
        print("Warning: No FASTA files detected yet in Intermediate/.")
    return sorted(samples)

SAMPLES = detect_samples()


# Working directories and folders
WORKDIR = pathlib.Path(os.getcwd())
OUTDIR  = WORKDIR / cfg["outdir"]
INTDIR  = WORKDIR / "Intermediate"
LOGDIR  = WORKDIR / "logs"
OUTDIR.mkdir(parents=True, exist_ok=True)
INTDIR.mkdir(parents=True, exist_ok=True)
LOGDIR.mkdir(parents=True, exist_ok=True)

# -------------------------------------------------------------------
# Configuration summary and mode validation
# -------------------------------------------------------------------
print("GenFlow Snakemake Pipeline starting...")


# Helper functions (embedded)
def find_fastas_from_defaults():
    """Return a sorted list of FASTA files automatically discovered in ./data and ./ (cwd)."""
    patterns = ["Data/*.fasta", "data/*.fasta", "*.fasta"]
    files = []
    for pat in patterns:
        for f in glob.glob(pat):
            p = pathlib.Path(f).resolve()
            if p.exists():
                files.append(str(p))
    return sorted(set(files))

def copy_fastas(fasta_csv, list_path, flag_path):
    """Copy input FASTA files into Intermediate/ and write bookkeeping files."""
    dest = INTDIR
    dest.mkdir(exist_ok=True)

    files = []
    if fasta_csv:
        # Split by comma, strip spaces, and resolve both relative and absolute paths
        for f in fasta_csv.split(","):
            p = pathlib.Path(f.strip())
            if not p.exists():
                p = (WORKDIR / f.strip()).resolve()
            if p.exists():
                files.append(str(p))
            else:
                print(f"Warning: FASTA file not found -> {f.strip()}")
    else:
        files = find_fastas_from_defaults()

    if not files:
        raise SystemExit("No FASTA files found. Place *.fasta under ./Data or cwd.")

    for f in files:
        sample = pathlib.Path(f).stem
        dest_path = dest / f"{sample}.fasta"
        src_path = pathlib.Path(f)
        if not src_path.exists():
            src_path = (WORKDIR / f).resolve()
        if src_path.exists() and src_path.is_file() and src_path.stat().st_size > 0:
            shutil.copy2(src_path, dest_path)
        else:
            print(f"Warning: FASTA file not found or empty -> {src_path}")

    with open(list_path, "w") as out:
        out.write("\n".join(files) + "\n")

    pathlib.Path(flag_path).write_text("collected\n")


def combine_fastas(out_fa):
    """Concatenate all FASTA from Intermediate/ into a single combined FASTA."""
    out = pathlib.Path(out_fa)
    out.parent.mkdir(parents=True, exist_ok=True)
    files = sorted(glob.glob(str(INTDIR / "*.fasta")))
    if not files:
        raise SystemExit("No FASTA in Intermediate/. Did collect_fastas run?")
    with open(out, "w") as OUT:
        for f in files:
            with open(f) as IN:
                txt = IN.read().rstrip()
                if not txt.endswith("\n"):
                    txt += "\n"
                OUT.write(txt)

# ---- Sample discovery from config or Data/ ----
def _get_sample_stems():
    """Return sorted unique stems from cfg['fasta'] (CSV) or auto-detected Data/*.fasta."""
    if cfg.get("fasta"):
        files = [s.strip() for s in str(cfg["fasta"]).split(",") if s.strip()]
    else:
        files = find_fastas_from_defaults()
    stems = [pathlib.Path(f).stem for f in files]
    return sorted(set(stems))

SAMPLES = _get_sample_stems()


# Default “tree” outputs
tree_target = [
    f"{cfg['outdir']}/combined.fasta",
    f"{cfg['outdir']}/aligned.fasta",
    f"{cfg['outdir']}/phylogenomic-tree.txt",
    f"{cfg['outdir']}/COLLECT_OK.txt",
]

# Add mode-specific required files: prokka GFFs for bacteria, UFCG outputs for fungi
if cfg.get("mode") == "bacteria":
    tree_target += [f"results/prokka/{s}/{s}.gff" for s in SAMPLES]
elif cfg.get("mode") == "fungi":
    # Ensure UFCG output is produced when running fungi mode
    tree_target += ["results/ufcg/core_genes.faa", "results/ufcg/core_genes.fna"]


# Optional targets (only if enabled through config flags)
ani_targets   = [f"{cfg['outdir']}/pyANI/ANIm_percentage_identity.tab"]
anvio_targets = [f"{cfg['outdir']}/Anvio/Filo/Filo-PAN.db"]

# Compose final target list for rule `all`
all_targets = list(tree_target)
if cfg.get("run_ani", False):
    all_targets += ani_targets
if cfg.get("run_anvio", False):
    all_targets += anvio_targets

rule all:
    """Top-level target gathering all requested outputs."""
    input: all_targets

# Collect FASTA into Intermediate/

rule collect_fastas:
    """Copy input FASTA into Intermediate/ and write bookkeeping files."""
    output:
        list=f"{cfg['outdir']}/COLLECT_OK.txt",
        flag="Intermediate/.collected",
        fastas=expand(
            "Intermediate/{sample}.fasta",
            sample=[pathlib.Path(f).stem for f in str(cfg.get("fasta", "")).split(",") if f.strip()]
        )
    run:
        copy_fastas(cfg.get("fasta"), output.list, output.flag)

# Dynamically detect samples after FASTA collection

def get_samples():
    import glob, pathlib
    return sorted([pathlib.Path(f).stem for f in glob.glob("Intermediate/*.fasta")])

print(f"Detected samples for annotation: {get_samples()}")



# 2) (Optional) NCBI download of genomes
# This block is enabled when cfg['use_ncbi_download'] is True.
# It expects `datasets` (NCBI) and EDirect in PATH.
use_ncbi = bool(cfg.get("use_ncbi_download", False))

if use_ncbi:
    rule ncbi_download:
        """Download reference genomes using NCBI datasets + unzip to Intermediate/."""
        input:
            "Intermediate/.collected"
        output:
            touch("logs/download.done")
        shell:
            r"""
            set -euo pipefail
            echo "Downloading genomes from NCBI..."
            # Clean the genomes list (remove comments and empty lines) into a safe temp file
            mkdir -p Intermediate
            grep -v '^\s*#' {cfg[genomes]} | sed '/^\s*$/d' > Intermediate/genomes.clean.txt
            if [ ! -s Intermediate/genomes.clean.txt ]; then
                echo "Error: No valid accessions found in {cfg[genomes]}" > logs/download.log
                exit 1
            fi

            conda run -n genflow-download-ani datasets download genome accession \
                --inputfile Intermediate/genomes.clean.txt > logs/download.log 2>&1
            unzip -o 'ncbi_*.zip' >> logs/download.log 2>&1
            mkdir -p Intermediate
            mv ncbi_dataset/data/GC*/*.fna Intermediate/ || true
            rm -rf ncbi_dataset *.zip md5sum.txt README.md || true
            echo "NCBI genome download complete."
            """
    upstream_flag = "logs/download.done"
else:
    upstream_flag = "Intermediate/.collected"

rule combine_fastas:
    """Concatenate all FASTA in Intermediate/ into a single combined FASTA."""
    input:
        upstream_flag
    output:
        f"{cfg['outdir']}/combined.fasta"
    run:
        combine_fastas(output[0])
# -------------------------------------------------------------------
# Organism-specific workflow: Bacteria vs Fungi
# -------------------------------------------------------------------

if cfg["mode"] == "bacteria":
    print("Bacterial workflow selected: Prokka -> Roary -> MAFFT -> FastTree/RAxML")

    rule annotate_prokka:
        """Annotate bacterial genomes with Prokka (using dedicated conda env)."""
        input:
            fastas=expand("Intermediate/{sample}.fasta", sample=[pathlib.Path(f).stem for f in str(cfg.get("fasta", "")).split(",") if f.strip()]),
            flag="Intermediate/.collected"
        output:
            expand("results/prokka/{sample}/{sample}.gff", sample=[pathlib.Path(f).stem for f in str(cfg.get("fasta", "")).split(",") if f.strip()])
        shell:
            r"""
            set -euxo pipefail
            mkdir -p results/prokka logs
            echo "Running Prokka annotations..."
            for f in {input.fastas}; do
                base=$(basename "$f" .fasta)
                echo "  → Annotating $base"
                conda run -n genflow-prokka prokka \
                    --outdir results/prokka/$base \
                    --prefix $base \
                    --cpus {cfg[threads]} \
                    --force "$f" 2>&1 | tee -a logs/prokka.log
            done
            echo "Prokka annotations complete."
            """

    rule pangenome_roary:
        """Run Roary to generate pangenome and core gene alignment."""
        input:
            gffs=expand("results/prokka/{sample}/{sample}.gff", sample=SAMPLES)
        output:
            "results/core_gene_alignment.aln"
        shell:
            r"""
            set -euo pipefail
            mkdir -p results/roary logs
            echo "Running Roary on annotated GFFs..."
            # Run Roary; it may create a timestamped directory (results/roary_XXXXXXXX).
            conda run -n genflow-roary roary \
                -e --mafft -p {cfg[threads]} -f results/roary {input.gffs} >> logs/roary.log 2>&1 || true

            # Prefer the plain results/roary folder if it contains the file, otherwise pick the
            # most recent results/roary_* directory created by Roary.
            if [ -f results/roary/core_gene_alignment.aln ]; then
                ROARY_DIR=results/roary
            else
                ROARY_DIR=$(ls -td results/roary_* 2>/dev/null | head -n1 || true)
            fi

            if [ -z "$ROARY_DIR" ]; then
                echo "Error: No Roary output directory found. See logs/roary.log for details."
                exit 1
            fi

            # Copy alignment (handle gzipped output)
            if [ -f "$ROARY_DIR/core_gene_alignment.aln" ]; then
                cp "$ROARY_DIR/core_gene_alignment.aln" {output}
            elif [ -f "$ROARY_DIR/core_gene_alignment.aln.gz" ]; then
                gunzip -c "$ROARY_DIR/core_gene_alignment.aln.gz" > {output}
            else
                echo "Error: core_gene_alignment.aln not found in $ROARY_DIR. Check logs/roary.log."
                exit 1
            fi

            echo "Roary complete."
            """

    rule align_mafft_bacteria:
        """Align Roary core gene alignment with MAFFT (if needed)."""
        input: "results/core_gene_alignment.aln"
        output: "results/aligned.fasta"
        shell:
            r"""
            set -euo pipefail
            echo "Aligning core genes with MAFFT..."
            conda run -n genflow-roary mafft --auto --thread {cfg[threads]} {input} > {output}
            """

elif cfg["mode"] == "fungi":
    print("Fungal workflow selected: UFCG -> FastTree/RAxML")

    rule run_ufcg:
        """Identify core fungal genes using the UFCG toolkit."""
        # envs/ is located at repo root; Snakefile sits in workflow/, so use a relative path
        conda: "../envs/ufcg-env.yml"
        input: 
            "Intermediate/.collected"
        output:
            faa="results/ufcg/core_genes.faa",
            fna="results/ufcg/core_genes.fna",
            dir=directory("results/ufcg")
        shell:
            r"""
            set -euo pipefail
            mkdir -p {output.dir} logs
            echo "Running UFCG pipeline on fungal genomes..."
            ufcg pipeline -i Intermediate -o {output.dir} --threads {cfg[threads]} >> logs/ufcg.log 2>&1
            echo "UFCG analysis complete."
            """

    rule align_ufcg:
        """Align fungal core genes using MAFFT (through Roary env)."""
        input: 
            "results/ufcg/core_genes.faa"
        output: 
            "results/aligned.fasta"
        shell:
            r"""
            set -euo pipefail
            echo "Aligning fungal core genes with MAFFT..."
            conda run -n genflow-roary mafft --auto --thread {cfg[threads]} {input} > {output}
            """


# -------------------------------------------------------------------
# Tree construction (shared between bacteria and fungi)
# -------------------------------------------------------------------

rule build_tree:
    """Build a phylogenomic tree using FastTree or RAxML."""
    input: "results/aligned.fasta"
    output: "results/phylogenomic-tree.txt"
    params:
        use_raxml=lambda wildcards: str(cfg.get("use_raxml", False)),
        threads=lambda wildcards: str(cfg["threads"]),
        DNA_mode=lambda wildcards: str(cfg["DNA_mode"]),
        datatype=lambda wildcards: " --datatype AA" if not cfg["DNA_mode"] else ""
    shell:
        r"""
        set -euo pipefail

        # Decide whether the alignment is nucleotide or protein by scanning characters
        # If the alignment (excluding header lines and gaps) contains only A,C,G,T,U,N (case-insensitive)
        # then treat as nucleotide and run FastTree with -nt. Otherwise run protein FastTree.
        ALN={input}
        IS_NUC=$(grep -v '^>' "$ALN" | tr -d '\n' | tr -d '\-.' | tr -d '[:space:]' | sed 's/[ACGTUNacgtun]//g' | wc -c)

        if [ "{params.use_raxml}" = "True" ]; then
            echo "Using RAxML (robust, slower)..."
            conda run -n genflow-raxml raxml-ng --msa {input} \
                --model GTR+G --threads {params.threads} \
                --tree pars{params.datatype} --outgroup 1 --prefix results/raxml_tree > logs/raxml.log 2>&1 || true
            cp results/raxml_tree.raxml.bestTree {output}
        else
            echo "Using FastTree (default)..."
                if [ "$IS_NUC" -eq 0 ] || [ "{params.DNA_mode}" = "True" ]; then
                echo "Detected nucleotide alignment -> running FastTree -nt"
                conda run -n genflow-roary FastTree -nt {input} > {output}
            else
                echo "Detected protein alignment -> running FastTree (AA)"
                conda run -n genflow-roary FastTree {input} > {output}
            fi
        fi
        """

# ANI with pyANI
if cfg.get("run_ani", False):

    rule ani_prepare:
        """Prepare pyANI labels/classes and copy FASTA into a dedicated folder."""
        input: "Intermediate/.collected"
        output:
            classes="results/classes.txt",
            labels="results/labels.txt",
            fasta_dir=directory("results/fasta_files")
        run:
            import os, glob, shutil, pathlib
            os.makedirs("results/fasta_files", exist_ok=True)
            fas = sorted(glob.glob("Intermediate/*.fasta")) + sorted(glob.glob("Intermediate/*.fa"))
            if not fas:
                raise SystemExit("No FASTA available for ANI.")
            for f in fas:
                dst = pathlib.Path("results/fasta_files") / (pathlib.Path(f).stem + ".fa")
                shutil.copy2(f, dst)
            paths = sorted(glob.glob("results/fasta_files/*.fa"))
            with open(output.classes, "w") as C, open(output.labels, "w") as L:
                for p in paths:
                    stem = pathlib.Path(p).stem
                    C.write(f"{p}\t{stem}\n")
                    L.write(f"{stem}\n")

    rule ani_run:
        """Run average_nucleotide_identity.py to compute ANI and export a matrix/figures."""
        input:
            classes="results/classes.txt",
            labels="results/labels.txt",
            fasta_dir=directory("results/fasta_files")
        output:
            "results/pyANI/ANIm_percentage_identity.tab"
        shell:
            r"""
            set -euo pipefail
            mkdir -p results/pyANI
            echo "Running pyANI analysis..."
            conda run -n genflow-download-ani average_nucleotide_identity.py \
                -i results/fasta_files \
                -o results/pyANI \
                --labels {input.labels} \
                --classes {input.classes} \
                -g --gmethod seaborn --gformat svg,png -v -l pyANI.log \
                --workers {cfg[threads]}
            """

    rule ani_all:
        """Convenience rule to chain ANI outputs into rule `all` when enabled."""
        input: "results/pyANI/ANIm_percentage_identity.tab"
        output: touch("results/.ani.done")
        shell: "echo 'ANI done' > /dev/null"

# anvi’o pangenome + core
if cfg.get("run_anvio", False):

    rule anvio_prepare:
        """Reformat FASTA, create contigs DBs and run HMMs for anvio."""
        input: "Intermediate/.collected"
        output: touch("logs/anvio_prepare.done")
        shell:
            r"""
            set -euo pipefail
            mkdir -p logs
            echo "Preparing contigs databases for anvio..."
            for i in Intermediate/*.fasta; do
                b=$(basename "$i" .fasta)
                echo "→ Processing $b ..."
                conda run -n genflow-roary anvi-script-reformat-fasta "$i" \
                    -o "Intermediate/${b}.fa" -l 1000 --simplify-names --seq-type NT >> logs/reformat.log 2>&1
                conda run -n genflow-roary anvi-gen-contigs-database \
                    -f "Intermediate/${b}.fa" -o "Intermediate/${b}.db" -T {cfg[threads]} >> logs/database.log 2>&1
                conda run -n genflow-roary anvi-run-hmms \
                    -c "Intermediate/${b}.db" -T {cfg[threads]} >> logs/hmms.log 2>&1
            done

            # Build external-genomes.txt for anvio
            ls -1 Intermediate/*.db > Intermediate/path.txt
            sed -i '1s/^/contigs_db_path\n/' Intermediate/path.txt
            ls -1 Intermediate/*.db | sed 's/.db//' > Intermediate/name.txt
            sed -i 's/[.]/_/g; s/-/_/g; s/,/_/g; s/ /_/g' Intermediate/name.txt
            sed -i '1s/^/name\n/' Intermediate/name.txt
            paste Intermediate/name.txt Intermediate/path.txt > Intermediate/external-genomes.txt
            rm Intermediate/name.txt Intermediate/path.txt
            echo "anvio preparation complete."
            """

    rule anvio_pangenome:
        """Run genomes-storage and pan-genome computation."""
        input: "logs/anvio_prepare.done"
        output: directory("results/Anvio/Filo")
        shell:
            r"""
            set -euo pipefail
            mkdir -p results/Anvio
            echo "Running anvio pangenome analysis..."
            conda run -n genflow-roary anvi-gen-genomes-storage \
                -e Intermediate/external-genomes.txt \
                -o results/Anvio/Filo-GENOMES.db >> logs/storage.log 2>&1

            conda run -n genflow-roary anvi-pan-genome \
                -g results/Anvio/Filo-GENOMES.db \
                --project-name Filo \
                --num-threads {cfg[threads]} \
                --mcl-inflation {cfg[mcl_inflation]} >> logs/pangenome.log 2>&1
            echo "anvio pangenome complete."
            """

    rule anvio_core_extract:
        """Extract core gene sequences (DNA and proteins) from the pan-genome."""
        input:
            db="results/Anvio/Filo-GENOMES.db",
            pan="results/Anvio/Filo/Filo-PAN.db"
        output:
            dna="results/Anvio/dna-sequences.fasta",
            prot="results/Anvio/proteins-sequences.fasta"
        shell:
            r"""
            set -euo pipefail
            NG=$(ls Intermediate/*.fa 2>/dev/null | wc -l || true)
            echo "Extracting core gene clusters from anvio..."
            # DNA (concatenated core)
            conda run -n genflow-roary anvi-get-sequences-for-gene-clusters \
                -g {input.db} -p {input.pan} -o results/Anvio/dna-sequences.fasta \
                --max-num-genes-from-each-genome 1 \
                --min-num-genomes-gene-cluster-occurs "$NG" \
                --concatenate-gene-clusters \
                --min-geometric-homogeneity-index {cfg[G]} \
                --min-functional-homogeneity-index {cfg[F]} \
                --report-DNA-sequences >> logs/core.log 2>&1 || true

            # Proteins (concatenated core)
            conda run -n genflow-roary anvi-get-sequences-for-gene-clusters \
                -g {input.db} -p {input.pan} -o results/Anvio/proteins-sequences.fasta \
                --max-num-genes-from-each-genome 1 \
                --min-num-genomes-gene-cluster-occurs "$NG" \
                --concatenate-gene-clusters \
                --min-geometric-homogeneity-index {cfg[G]} \
                --min-functional-homogeneity-index {cfg[F]} >> logs/core.log 2>&1 || true
            echo "anvio core gene extraction complete."
            """

    rule anvio_align_tree:
        """Align core (DNA or protein) and build a phylogenomic tree with FastTree."""
        input:
            fasta=lambda wildcards: "results/Anvio/dna-sequences.fasta" if cfg["DNA_mode"] else "results/Anvio/proteins-sequences.fasta"
        output:
            "results/Anvio/core-aligned.fasta",
            "results/Anvio/phylogenomic-tree.txt"
        shell:
            r"""
            set -euo pipefail
            echo "Aligning core sequences and building tree with FastTree..."
            conda run -n genflow-roary mafft --retree 1 --thread {cfg[threads]} --maxiterate 0 {input.fasta} > results/Anvio/core-aligned.fasta 2>> logs/mafft_core.log
            if [ "{cfg[DNA_mode]}" = "True" ]; then
                conda run -n genflow-roary FastTree -nt results/Anvio/core-aligned.fasta > results/Anvio/phylogenomic-tree.txt 2>> logs/tree_core.log
            else
                conda run -n genflow-roary FastTree results/Anvio/core-aligned.fasta > results/Anvio/phylogenomic-tree.txt 2>> logs/tree_core.log
            fi
            echo "anvio tree complete."
            """

