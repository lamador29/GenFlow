BootStrap: docker
From: continuumio/miniconda3:latest

%labels
    Description GenFlow - Bacterial and Fungal Genomic Workflow (Singularity Container)

%help
    GenFlow Singularity Container
    
    Bacterial and fungal phylogenomic workflow including:
    - Prokka: Genome annotation
    - Roary: Pangenome analysis
    - UFCG: Fungal profiling
    - RAxML/FastTree: Phylogenomic tree building
    - pyANI: Average Nucleotide Identity
    
    Usage:
        singularity run genflow.sif snakemake --cores 8 --use-conda --config fasta="Data/*.fasta"
        
    For interactive access:
        singularity shell genflow.sif

%environment
    export DEBIAN_FRONTEND=noninteractive
    export CONDA_AUTO_UPDATE_CONDA=false
    export PATH=/opt/conda/bin:$PATH
    export PYTHONUNBUFFERED=1
    export SNAKEMAKE_CORES=8
    export SNAKEMAKE_THREADS=8

%post
    # Set environment
    export DEBIAN_FRONTEND=noninteractive
    export CONDA_AUTO_UPDATE_CONDA=false
    export PATH=/opt/conda/bin:$PATH
    
    # Update system packages
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        wget \
        curl \
        git \
        nano \
        less \
        ca-certificates \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/*
    
    # Configure conda
    conda config --system --prepend channels conda-forge
    conda config --system --set auto_update_conda false
    
    # Create base environment
    echo "Creating genflow-base environment..."
    conda create -y -n genflow-base \
        snakemake=7.* \
        python=3.10 \
        && conda clean -afy
    
    # Create download-ani environment
    echo "Creating genflow-download-ani environment..."
    conda create -y -n genflow-download-ani \
        -c bioconda -c conda-forge \
        ncbi-datasets-cli \
        average-nucleotide-identity \
        r-base \
        r-ggplot2 \
        r-reshape2 \
        r-gridextra \
        r-viridis \
        && conda clean -afy
    
    # Create prokka environment
    echo "Creating genflow-prokka environment..."
    conda create -y -n genflow-prokka \
        -c bioconda -c conda-forge \
        prokka \
        && conda clean -afy
    
    # Create roary environment
    echo "Creating genflow-roary environment..."
    conda create -y -n genflow-roary \
        -c bioconda -c conda-forge \
        roary \
        mafft \
        fasttree \
        && conda clean -afy
    
    # Create raxml environment
    echo "Creating genflow-raxml environment..."
    conda create -y -n genflow-raxml \
        -c bioconda -c conda-forge \
        raxml-ng \
        && conda clean -afy
    
    # Create ufcg environment
    echo "Creating ufcg environment..."
    conda create -y -n ufcg \
        -c bioconda -c conda-forge \
        ufcg \
        && conda clean -afy
    
    # Create working directories
    mkdir -p /workspace/GenFlow/Intermediate
    mkdir -p /workspace/GenFlow/results
    mkdir -p /workspace/GenFlow/logs
    mkdir -p /workspace/GenFlow/tmp
    
    echo "GenFlow Singularity container initialized successfully"

%files
    . /workspace/GenFlow/

%runscript
    #!/bin/bash
    # Initialize bash with conda
    source /opt/conda/etc/profile.d/conda.sh
    
    # Print usage information
    if [ $# -eq 0 ]; then
        echo "GenFlow - Genomic Workflow Container"
        echo ""
        echo "Usage:"
        echo "  singularity run genflow.sif snakemake [OPTIONS]"
        echo "  singularity exec genflow.sif bash"
        echo ""
        echo "Available conda environments:"
        conda env list | grep genflow
        echo ""
        echo "Example workflows:"
        echo "  # Bacteria with local FASTA"
        echo "  singularity run genflow.sif snakemake --cores 8 --use-conda \\"
        echo "    --config fasta='Data/genome1.fasta,Data/genome2.fasta'"
        echo ""
        echo "  # Bacteria with NCBI download"
        echo "  singularity run genflow.sif snakemake --cores 8 --use-conda \\"
        echo "    --config use_ncbi_download=true genomes='Data/short.txt'"
        echo ""
        echo "  # Fungi (requires 4+ genomes)"
        echo "  singularity run genflow.sif snakemake --cores 8 --use-conda \\"
        echo "    --config mode=fungi genomes='Data/genomes.txt'"
        echo ""
    else
        # Run the provided command
        cd /workspace/GenFlow
        exec "$@"
    fi

%apprun snakemake
    #!/bin/bash
    source /opt/conda/etc/profile.d/conda.sh
    conda activate genflow-base
    cd /workspace/GenFlow
    snakemake "$@"

%apphelp snakemake
    Run Snakemake workflows
    
    Usage: singularity run --app snakemake genflow.sif [SNAKEMAKE OPTIONS]
    
    Examples:
        singularity run --app snakemake genflow.sif --cores 8 --use-conda \
            --config fasta='Data/*.fasta'
